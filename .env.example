# .env.example — NAMES ONLY. Never commit real values.
# Copy to .env.local for local dev: cp .env.example .env.local
# Real values live in Bitwarden (Teams vault, "START-SYS" collection) unless noted.
# "preview-scoped" means Vercel Preview environment gets a DIFFERENT value than
# Production (pointed at the seeded staging Supabase project — ARCHITECTURE.md §7).

# Supabase project URL. Safe to ship to the browser (NEXT_PUBLIC_).
# Bitwarden item: "Supabase — START-SYS — Project URL". Preview-scoped (staging project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Safe to ship to the browser — RLS is the boundary.
# Bitwarden item: "Supabase — START-SYS — anon key". Preview-scoped (staging project key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. NEVER ship to the browser. Read ONLY by
# lib/server/admin-client.ts (invite flow + backup job) — CLAUDE.md banned pattern otherwise.
# Bitwarden item: "Supabase — START-SYS — service_role key". Preview-scoped (staging project key).
SUPABASE_SERVICE_ROLE_KEY=

# Which document store backs lib/documents/. One of: fake | drive | supabase_storage.
# fake = unit/e2e tests. drive = Google Drive (primary, PRD addendum). supabase_storage =
# ARCHITECTURE §4.1 fallback if the org has no Shared Drive tenant (OQ-1). Not a secret.
# Preview-scoped (previews always run "fake" for determinism).
DOCUMENT_STORE=fake

# Google service account email, for Drive resumable-upload session minting (drive.file scope
# only — ARCHITECTURE §1). Bitwarden item: "Google Cloud — START-SYS — service account".
GOOGLE_SA_CLIENT_EMAIL=

# Google service account private key (PEM). NEVER logged, NEVER in a client bundle.
# Bitwarden item: "Google Cloud — START-SYS — service account" (private key field).
GOOGLE_SA_PRIVATE_KEY=

# The org's Google Shared Drive ID that holds proof-of-enrollment files.
# Bitwarden item: "Google Drive — START-SYS — Shared Drive ID". Preview-scoped (staging drive).
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Folder within the Shared Drive where proof-of-enrollment files are uploaded.
# Bitwarden item: "Google Drive — START-SYS — Proof of Enrollment folder ID". Preview-scoped.
GOOGLE_DRIVE_PROOF_FOLDER_ID=

# Shared secret required on every /api/jobs/* request (scheduled.yml callers).
# Bitwarden item: "START-SYS — JOB_SHARED_SECRET". Preview-scoped (separate secret per env).
JOB_SHARED_SECRET=

# Sentry DSN for error tracking (beforeSend strips request bodies — see ARCHITECTURE §1).
# Bitwarden item: "Sentry — START-SYS — DSN". Not preview-scoped (same project, tagged by env).
SENTRY_DSN=

# HMAC key used to hash IP addresses before they reach the rate-limit table (a raw IP is
# personal data under RA 10173 and must never be stored in plaintext — BUILD_PLAN S3-T7).
# Bitwarden item: "START-SYS — RATE_LIMIT_HMAC_KEY". Preview-scoped (separate key per env).
RATE_LIMIT_HMAC_KEY=

# Where the FAKE document store keeps its bytes. Optional; defaults to a fixed directory
# under the OS temp dir. Only read when DOCUMENT_STORE=fake, and only exists because the
# Next server process, the Playwright process and any build workers are separate V8
# isolates — a module-level Map in one is invisible to the others, so the filesystem is
# what lets a browser's PUT be seen by the spec that asserts on it. Not a secret; never
# set in production, where DOCUMENT_STORE is `drive` (or `supabase_storage`, ADR 0005).
FAKE_STORE_DIR=

# Set by Node, Next.js and Vitest — you do not set this by hand. It is registered here
# because .env.example is the register of EVERY variable the code reads (S1-T24's CI
# check), and lib/rate-limit/ reads it to decide one thing: whether a missing
# RATE_LIMIT_HMAC_KEY is a hard failure. In production it is — a predictable HMAC key
# makes the rate-limit digests reversible, and hashing the subject is the whole reason
# that module exists. Outside production it falls back to a fixed dev pepper, so a
# developer or a CI run without the secret does not take the public application form
# down (BUILD_PLAN S3-T7). Not a secret.
NODE_ENV=
