-- ═══════════════════════════════════════════════════════════════════════════════════
-- 2 — eleven more memberships, ALL in the ACTIVE term
-- ═══════════════════════════════════════════════════════════════════════════════════
-- Every row is inserted as 'active' and three are moved to their real status in §4.
-- enforce_membership_transition() (0028) permits only 'active' or 'renewal_pending' as a
-- STARTING state — a person cannot be born graduated — so a fixture that seeded 'graduated'
-- directly would fail at the trigger with an error naming a file nobody would think to open.
--
-- Regions are resolved by CODE, never by a hardcoded uuid: 0016 generates region ids with
-- gen_random_uuid(), so a literal would be wrong on every fresh database. Region A = NCR,
-- region B = R07 (Central Visayas), per the cross-lane contract fixtures.psql establishes.
--
-- year_level and expected_grad_year vary so nothing downstream can accidentally depend on a
-- constant, and both satisfy their CHECKs (1..8, 2000..2100).
insert into public.memberships (
  id, person_id, term_id, status, region_id, year_level, expected_grad_year
)
select v.id, v.person_id, pg_temp.fx_active_term(), 'active'::public.membership_status,
       r.id, v.year_level, v.expected_grad_year
from (values
  -- ── region A (NCR) — five stay active, D06/D07 become graduated in §4 ──
  ('00000000-0000-4000-c200-000000000001'::uuid, '00000000-0000-4000-b200-000000000001'::uuid, 'NCR', 1, 2030),
  ('00000000-0000-4000-c200-000000000002'::uuid, '00000000-0000-4000-b200-000000000002'::uuid, 'NCR', 2, 2029),
  ('00000000-0000-4000-c200-000000000003'::uuid, '00000000-0000-4000-b200-000000000003'::uuid, 'NCR', 2, 2029),
  ('00000000-0000-4000-c200-000000000004'::uuid, '00000000-0000-4000-b200-000000000004'::uuid, 'NCR', 3, 2028),
  ('00000000-0000-4000-c200-000000000005'::uuid, '00000000-0000-4000-b200-000000000005'::uuid, 'NCR', 3, 2028),
  ('00000000-0000-4000-c200-000000000006'::uuid, '00000000-0000-4000-b200-000000000006'::uuid, 'NCR', 4, 2026),
  ('00000000-0000-4000-c200-000000000007'::uuid, '00000000-0000-4000-b200-000000000007'::uuid, 'NCR', 4, 2026),
  -- ── region B (R07) — three stay active, D11 becomes resigned in §4 ──
  ('00000000-0000-4000-c200-000000000008'::uuid, '00000000-0000-4000-b200-000000000008'::uuid, 'R07', 1, 2030),
  ('00000000-0000-4000-c200-000000000009'::uuid, '00000000-0000-4000-b200-000000000009'::uuid, 'R07', 2, 2029),
  ('00000000-0000-4000-c200-000000000010'::uuid, '00000000-0000-4000-b200-000000000010'::uuid, 'R07', 3, 2028),
  ('00000000-0000-4000-c200-000000000011'::uuid, '00000000-0000-4000-b200-000000000011'::uuid, 'R07', 4, 2027)
) as v(id, person_id, region_code, year_level, expected_grad_year)
join public.regions r on r.code = v.region_code
on conflict do nothing;


-- ═══════════════════════════════════════════════════════════════════════════════════
-- 3 — a SECOND committee, and the shared member
-- ═══════════════════════════════════════════════════════════════════════════════════
-- CBL Art. III §5: committees are discretionary and per-term, which is why 0016 seeds none
-- and both of this suite's committees are created in fixtures. FIXT_ETHICS
-- (…e000-000000000001, from fixtures.psql) hangs off the CRRD department; this one hangs off
-- TECHNOLOGY, so the committee view is exercised across two different parent departments and
-- nothing can quietly come to depend on there being one.
--
-- Department is resolved by CODE for the ACTIVE term. 0016 seeds the seven CBL Art. III §4
-- departments per term with stable cross-term codes, so 'TECH' is the same department every
-- year while its id is not.
insert into public.committees (id, term_id, department_id, code, name)
select '00000000-0000-4000-e200-000000000001',
       pg_temp.fx_active_term(),
       d.id,
       'FIXT_DASH_OPS',
       'Fixture Dashboard Operations Committee'
from public.departments d
where d.term_id = pg_temp.fx_active_term()
  and d.code    = 'TECH'
on conflict (id) do nothing;

-- ★ D01 IS THE SHARED MEMBER — one scholar, two seats. ★
-- This is the row that makes the committee panel's non-sum a measured fact:
--   4 distinct memberships hold a seat (P4, P6, D01, D02)
--   but 5 committee_memberships rows exist,
--   so the named buckets total 5 and the unassigned bucket is 15 - 4 = 11, giving 16 against
--   a headcount of 15.
-- ADR 0007 §4. Remove this row and 065 stops proving the property the view exists to have.
--
-- D01 and D02 are both NCR on purpose: it puts BOTH committees inside region A, so rep_a
-- sees three buckets and rep_b sees two. A committee whose members straddled the regions
-- symmetrically would let a scoping bug return a plausible-looking answer.
insert into public.committee_memberships (membership_id, committee_id)
values
  ('00000000-0000-4000-c200-000000000001', '00000000-0000-4000-e000-000000000001'),  -- D01 -> ETHICS
  ('00000000-0000-4000-c200-000000000001', '00000000-0000-4000-e200-000000000001'),  -- D01 -> DASH_OPS  (the shared seat)
  ('00000000-0000-4000-c200-000000000002', '00000000-0000-4000-e200-000000000001')   -- D02 -> DASH_OPS
on conflict do nothing;


-- ═══════════════════════════════════════════════════════════════════════════════════
-- 4 — the two non-active statuses
-- ═══════════════════════════════════════════════════════════════════════════════════
-- active -> graduated and active -> resigned are both legal edges in the ONE inline VALUES
-- list in enforce_membership_transition() (0028) and NEITHER carries a role guard: only the
-- two `terminated` edges are reserved to exec_admin (CBL Art. VII §3.2.3, §3.2.5-3.2.6), and
-- only they require a written ground in ended_reason. These two therefore succeed as the
-- session role with no JWT claims set, which is the state this file runs in.
--
-- ⚠ THIS MUST STAY AN UPDATE AND CANNOT BECOME AN INSERT. See §2's note: the trigger's
--   INSERT branch admits only 'active' and 'renewal_pending'.
--
-- ⚠ AND IT MUST STAY ON THE ACTIVE TERM. trg_memberships_freeze_archived (0006) fires BEFORE
--   UPDATE as well as BEFORE INSERT, so the same two statements against an archived term
--   would raise 42501. This file adds nothing to the archived term at all.
--
-- Two graduated in region A and one resigned in region B, deliberately asymmetric: region A
-- and region B carry DIFFERENT status sets, so a scoping bug cannot produce a symmetric
-- answer that still looks right.
update public.memberships
   set status = 'graduated'
 where id in ('00000000-0000-4000-c200-000000000006',   -- D06, NCR
              '00000000-0000-4000-c200-000000000007')   -- D07, NCR
   and status = 'active';

update public.memberships
   set status = 'resigned'
 where id = '00000000-0000-4000-c200-000000000011'      -- D11, R07
   and status = 'active';

-- No convenience lookup functions are defined here, deliberately. fixtures.psql exports
-- fx_active_term(), fx_archived_term() and fx_region() because their ids are GENERATED
-- (gen_random_uuid() in 0016) and cannot be written down; every id this file adds is a fixed
-- literal from the arithmetic table above, so a helper would only be a second place to keep
-- the same constant.
